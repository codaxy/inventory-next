{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "DataProtection": {
    "KeyRingPath": "/var/lib/inventory/keys"
  },
  "Auth": {
    "AllowedDomains": [
      "codaxy.com"
    ],
    "AllowedUsers": [],
    "DeniedUsers": [],
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "OneTimeCode": {
      "Enabled": false,
      "Validity": "00:10:00",
      "Cooldown": "00:01:00"
    }
  },
  "RateLimit": {
    "SignIn": {
      "Permits": 10,
      "Window": "00:05:00"
    }
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "From": "inventory@codaxy.com"
  },
  "AllowedHosts": "*"
}
