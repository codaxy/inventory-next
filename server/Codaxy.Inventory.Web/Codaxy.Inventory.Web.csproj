<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Google credentials in development go here, never into a settings file. -->
    <UserSecretsId>codaxy-inventory-next</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Codaxy.Inventory.Tests.Unit" />
    <InternalsVisibleTo Include="Codaxy.Inventory.Tests.Integration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codaxy.Inventory.App\Codaxy.Inventory.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.4" />
    <PackageReference
      Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore"
      Version="10.0.12"
    />
    <!-- `dotnet ef` runs through the startup project, so the design package lives here. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Installs the pre-commit hook after restore, so a clone that builds the server has it. Runs again
       only when the tool manifest changes. `HUSKY=0` turns it off where there is no repository to
       hook: the image build and CI. -->
  <PropertyGroup>
    <HuskyRoot Condition="'$(HuskyRoot)' == ''">../../</HuskyRoot>
  </PropertyGroup>

  <Target
    Name="Husky"
    AfterTargets="Restore"
    Condition="'$(HUSKY)' != 0"
    Inputs="$(HuskyRoot).config/dotnet-tools.json"
    Outputs="$(HuskyRoot).husky/_/install.stamp"
  >
    <Exec
      Command="dotnet tool restore"
      StandardOutputImportance="Low"
      StandardErrorImportance="High"
      WorkingDirectory="$(HuskyRoot)"
    />
    <Exec
      Command="dotnet husky install"
      StandardOutputImportance="Low"
      StandardErrorImportance="High"
      WorkingDirectory="$(HuskyRoot)"
    />
    <Touch Files="$(HuskyRoot).husky/_/install.stamp" AlwaysCreate="true" />
  </Target>
</Project>
