{
    "name": "inventory-client",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "vite build",
        "format": "prettier --write \"src/**/*.{ts,tsx,scss,html}\" \"*.{json,js}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,scss,html}\" \"*.{json,js}\"",
        "prestart": "node -e \"require('fs').mkdirSync('.certs', { recursive: true })\" && dotnet dev-certs https --export-path .certs/localhost.pem --format PEM --no-password",
        "start": "vite",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fontsource/montserrat": "^5.3.0",
        "cx": "^26.9.3",
        "cx-react": "^26.1.0",
        "cx-theme-variables": "^26.4.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "prettier": "^3.9.9",
        "sass": "^1.97.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.7.3",
        "vite": "^8.3.1"
    }
}
