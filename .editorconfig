root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.{cs,csx}]
indent_style = space
indent_size = 4

# EF Core's migration generator ignores this, so migrations are block-scoped, and left as generated
# rather than converted: the next `migrations add` would undo it.
csharp_style_namespace_declarations = file_scoped
